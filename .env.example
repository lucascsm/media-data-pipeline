# Set these in the process environment; this file is not loaded automatically.
# Defaults resolve paths relative to the project when these are omitted.
CONFIG_DIR=./config
GCS_MOUNT=./data
OUTPUT_PATH=./data/output
ACCOUNT_CATALOG_PATH=./config/accounts.yaml
PIPELINE_TIMEZONE=America/Sao_Paulo
# Optional, for the archived recommendation script only.
GEMINI_API_KEY=REPLACE_WITH_YOUR_API_KEY
