CREATE OR REPLACE TABLE `${PROJECT_ID}.${DATASET_REPORTS}.resumo_semanal_pbi` AS
WITH produto_b AS(
    SELECT
    semana,
    nome_semana,
    nome_grupo_anuncio,
    visao,
    plataforma,
    'Produto B' AS produto,
    SUM(custo) AS custo,
    SUM(impressoes) AS impressoes,
    SUM(cliques) AS clique,
    IFNULL(SAFE_DIVIDE(SUM(parcela_impr * impressoes), SUM(impressoes)),0) AS parcela_impressao,
    SUM(conversoes) AS conversoes,
    IFNULL(SAFE_DIVIDE(SUM(cliques), SUM(impressoes)),0) AS CTR,
    IFNULL(SAFE_DIVIDE(SUM(custo), SUM(conversoes)),0) AS CPA,
    IFNULL(SAFE_DIVIDE(SUM(conversoes), SUM(cliques)),0) AS taxa_conversao
    FROM ${PROJECT_ID}.${DATASET_REPORTS}.resumo_semanal_produto_b
    WHERE custo>0
    GROUP BY 1,2,3,4,5
    
),
